# viral-radar/.env.example
# 사용법: cp .env.example .env 후 값 채우기. 전부 비워도 파이프라인은 죽지 않는다 —
# 각 provider가 스스로 "비활성" 상태를 보고한다(§32).

# ── AI 장르 분류 (lib/classify.js) ──────────────────────────────────────────
# 없으면 classify()가 { needsManualClassification: true }를 반환하고 스크립트가 계속 진행된다.
# scripts/export-for-classify.js + apply-classification.js로 수동 처리 가능(이번 PoC가 그 방식).
ANTHROPIC_API_KEY=

# ── YouTube 공식 Data API (providers/youtubeDataApi.js) ────────────────────
# https://console.cloud.google.com/apis/library/youtube.googleapis.com 에서 발급, 완전 무료.
# 없으면 providers/youtubeSearchScrape.js(키리스 스크래핑, 정확도 낮음)만 사용됨.
YOUTUBE_API_KEY=

# ── 유료 공급자 (SOURCE_AUDIT.md 참고, 계약 전까진 전부 비활성) ─────────────
# Viral Outliers: https://www.viraloutliers.com/ (7일 무료체험)
VIRAL_OUTLIERS_API_KEY=
# EnsembleData: https://ensembledata.com/ (TikTok/Instagram Reels, Free 50유닛/일)
ENSEMBLEDATA_TOKEN=
# Douyin: 이번 조사로 구체 업체 미확정(SOURCE_AUDIT.md §2-1 참고)
DOUYIN_PROVIDER_TOKEN=

# ── 실행 모드 ────────────────────────────────────────────────────────────
# Instagram 실게시 코드가 아직 없어 지금은 아무 효과 없음(§29). 발행 단계가 붙으면
# DRY_RUN=false로 명시할 때만 실제 게시되게 만들 것(기존 instagram-publish.js와 동일 패턴).
DRY_RUN=true
