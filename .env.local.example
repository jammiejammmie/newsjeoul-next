# 뉴스저울 로컬 환경변수 템플릿
# ---------------------------------------------------------------------------
# 사용법: 이 파일을 .env.local로 복사하고 값만 채운다. (.env.local은 .gitignore에 있다)
#
#   cp .env.local.example .env.local
#
# 왜 필요한가: scripts/*.js 진단 스크립트는 전부 첫 줄에서 .env.local을 직접 읽는다
# (dotenv를 안 쓰고 fs.readFileSync로 파싱한다). 파일이 없으면 스크립트가 시작하자마자
# ENOENT로 죽는다. 머신마다 저장 위치가 달라 새 머신에서 늘 이 문제를 겪는다.
#
# 형식 주의: 스크립트의 파서가 `^([A-Z0-9_]+)=(.*)$` 정규식이다.
#   · 값에 따옴표를 씌우지 마라(따옴표까지 값으로 들어간다)
#   · 키 앞에 공백을 넣지 마라
#   · 줄바꿈 없는 한 줄 값이어야 한다
# ---------------------------------------------------------------------------

# ── Supabase ────────────────────────────────────────────────────────────────
# 대시보드 → Project Settings → API
# URL은 공개값이라 이미 저장소에 하드코딩된 곳이 있다(.github/workflows/recover-pipeline.yml).
NEXT_PUBLIC_SUPABASE_URL=https://xlxztrnpmzklbnyfkrze.supabase.co

# anon(public) 키 — RLS가 걸린 읽기 전용 조회용. 대부분의 진단 스크립트가 이걸 쓴다.
#   scripts/check-publish-throughput.js · check-home-modules.js · check-threads-latest.js
#   check-distribution-health.js · check-hero-rotation.js · check-run-log.js 등
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키 — RLS를 우회한다. Netlify 함수를 로컬에서 돌릴 때만 필요하고,
# 조회만 할 거면 비워 둬도 된다. ★ 절대 커밋하지 말 것.
SUPABASE_SERVICE_KEY=

# Netlify 함수 코드가 참조하는 이름(위 NEXT_PUBLIC_SUPABASE_URL과 같은 값).
# 함수를 로컬 실행할 때만 필요하다.
SUPABASE_URL=https://xlxztrnpmzklbnyfkrze.supabase.co

# ── 함수 수동 트리거 ────────────────────────────────────────────────────────
# 배포된 Netlify 함수를 손으로 호출할 때 x-admin-key 헤더에 넣는 값.
# GitHub Secret NEWSJEOUL_ADMIN_KEY와 같은 값이다(Netlify 환경변수 ADMIN_KEY).
# 예: curl -X POST -H "x-admin-key: $ADMIN_KEY" \
#       "https://newsjeoul.co.kr/.netlify/functions/generate-hub-documents-background?limit=8"
ADMIN_KEY=

# ── 외부 API (함수 로컬 실행 시에만) ────────────────────────────────────────
# 콘텐츠 생성 파이프라인용. 조회 전용 진단에는 필요 없다.
ANTHROPIC_API_KEY=

# Threads 자동 게시용. 조회 전용 진단에는 필요 없다.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# ── 선택 ────────────────────────────────────────────────────────────────────
# 파이프라인 정체 알림. 비워 두면 check-pipeline-health가 콘솔에만 남긴다
# (현재 운영이 이 상태다 — 감지기가 이상을 찾아도 알리는 곳이 없다).
SLACK_WEBHOOK_URL=

# post-threads 게시 간격(ms). 비우면 기본값 2~5분.
POST_GAP_MIN_MS=
POST_GAP_MAX_MS=
